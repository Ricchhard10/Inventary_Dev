{
  "expo": {
    "name": "Inventary Dev",
    "slug": "bugdev-inventario",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon-arcade.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon-arcade.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bugdevsv.inventario"
    },
    "android": {
      "package": "com.bugdevsv.inventario",
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/icon-arcade.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      "./plugins/withOfflineRelease.cjs"
    ]
  }
}
